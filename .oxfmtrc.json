{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/*.md",
    "packages/schema/src/**",
    "apps/table/src/dev/fixture.json",
    "apps/table/src/dev/roles.json",
    "packages/ui/src/fonts.css",
    "packages/ui/src/tokens.css",
    "systems/*/content/**"
  ]
}
