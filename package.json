{
  "name": "tablewright",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run lint:design && bun run tokens:check && bun run typecheck:tools && turbo run check && bun run check:rust",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "dev:table": "bun run --cwd apps/table dev",
    "dev:tunnel": "bun run --cwd apps/table dev:tunnel",
    "demo": "bun run --cwd apps/table demo",
    "stop": "bun run tools/stop.ts",
    "format": "oxfmt",
    "icon:table": "bun run tools/app-icon.ts",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "perf": "bun run --filter @tablewright/table e2e:perf",
    "e2e": "bun run --filter @tablewright/table e2e",
    "lint:design": "bun x @google/design.md@0.4.0 lint DESIGN.md",
    "tokens": "bun run tools/build-tokens.ts",
    "tokens:check": "bun run tools/build-tokens.ts --check",
    "typecheck:tools": "tsc -p tools",
    "test": "turbo run test",
    "import:srd": "bun run tools/import-srd.ts",
    "seed": "bun run --filter @tablewright/table seed",
    "schema": "cargo run -p table --bin schema"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
