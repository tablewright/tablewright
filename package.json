{
  "name": "tablewright",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && turbo run check && bun run check:rust",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "dev:table": "bun run --filter @tablewright/table dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
